<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="academicmanagmentsystem.controller.UserManagementController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="User Management" style="-fx-font-size: 18; -fx-font-weight: bold;" />

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Search:" />
        <TextField fx:id="searchField" promptText="Search by username or name" prefWidth="250" />
        <Button text="Search" onAction="#handleSearch" />
        <Button text="Refresh" onAction="#refreshUsers" />
    </HBox>

    <Label text="All Users" style="-fx-font-weight: bold;" />

    <TableView fx:id="usersTable" prefHeight="250">
        <columns>
            <TableColumn fx:id="usernameColumn" text="Username" prefWidth="120" />
            <TableColumn fx:id="roleColumn" text="Role" prefWidth="100" />
            <TableColumn fx:id="nameColumn" text="Full Name" prefWidth="180" />
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="180" />
            <TableColumn fx:id="detailsColumn" text="Details" prefWidth="150" />
        </columns>
    </TableView>

    <Label text="Add/Edit User" style="-fx-font-weight: bold; -fx-font-size: 16;" />

    <GridPane hgap="10" vgap="10">
        <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="usernameField" promptText="Enter username" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="passwordField" promptText="Enter password" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Role:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <ComboBox fx:id="roleComboBox" promptText="Select role" GridPane.columnIndex="1" GridPane.rowIndex="2" onAction="#handleRoleSelection" />

        <Label text="First Name:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="firstNameField" promptText="Enter first name" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Last Name:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="lastNameField" promptText="Enter last name" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <TextField fx:id="emailField" promptText="Enter email" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <Label fx:id="roleFieldLabel" text="Major:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <TextField fx:id="roleSpecificField" promptText="Role-specific field" GridPane.columnIndex="1" GridPane.rowIndex="6" />
    </GridPane>

    <Label fx:id="messageLabel" textFill="GREEN" style="-fx-font-weight: bold;" />

    <HBox spacing="10" alignment="CENTER">
        <Button text="Add User" onAction="#handleAddUser" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="120" />
        <Button text="Update User" onAction="#handleUpdateUser" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="120" />
        <Button text="Delete User" onAction="#handleDeleteUser" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="120" />
        <Button text="Clear Form" onAction="#clearForm" prefWidth="100" />
        <Button text="Back to Dashboard" onAction="#handleBack" prefWidth="150" />
    </HBox>
</VBox>
