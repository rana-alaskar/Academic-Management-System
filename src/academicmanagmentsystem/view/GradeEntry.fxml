<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="academicmanagmentsystem.controller.GradeEntryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Grade Entry" style="-fx-font-size: 18; -fx-font-weight: bold;" />

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Select Course:" style="-fx-font-weight: bold;" />
        <ComboBox fx:id="courseComboBox" promptText="Choose a course" prefWidth="350" onAction="#handleCourseSelection" />
    </HBox>

    <Label text="Students Enrolled" style="-fx-font-weight: bold;" />

    <TableView fx:id="studentsTable" prefHeight="350">
        <columns>
            <TableColumn fx:id="studentIdColumn" text="Student ID" prefWidth="120" />
            <TableColumn fx:id="studentNameColumn" text="Student Name" prefWidth="200" />
            <TableColumn fx:id="majorColumn" text="Major" prefWidth="150" />
            <TableColumn fx:id="currentGradeColumn" text="Current Grade" prefWidth="100" />
        </columns>
    </TableView>

    <Label text="Enter/Update Grade for Selected Student" style="-fx-font-weight: bold;" />

    <GridPane hgap="10" vgap="10">
        <Label text="Student:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <Label fx:id="selectedStudentLabel" text="None selected" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Grade:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="gradeComboBox" promptText="Select grade" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    </GridPane>

    <Label fx:id="messageLabel" textFill="GREEN" style="-fx-font-weight: bold;" />

    <HBox spacing="10" alignment="CENTER">
        <Button text="Save Grade" onAction="#handleSaveGrade" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="120" />
        <Button text="Update Grade" onAction="#handleUpdateGrade" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="120" />
        <Button text="Clear Grade" onAction="#handleClearGrade" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="120" />
        <Button text="Refresh" onAction="#refreshStudents" prefWidth="100" />
        <Button text="Back to Dashboard" onAction="#handleBack" prefWidth="150" />
    </HBox>
</VBox>
