<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="academicmanagmentsystem.controller.StudentGradesController">

    <!-- Top: Header -->
    <top>
        <VBox style="-fx-background-color: #2196F3; -fx-padding: 15;">
            <Label text="My Grades" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
            </Label>
            <Label fx:id="studentInfoLabel" text="Student Information" textFill="WHITE">
                <font>
                    <Font size="14.0" />
                </font>
            </Label>
        </VBox>
    </top>

    <!-- Center: Grades Table -->
    <center>
        <VBox spacing="15" style="-fx-padding: 20;">
            <Label text="Grade History" style="-fx-font-size: 16; -fx-font-weight: bold;" />

            <TableView fx:id="gradesTable" prefHeight="400">
                <columns>
                    <TableColumn fx:id="courseCodeColumn" text="Course Code" prefWidth="120" />
                    <TableColumn fx:id="courseNameColumn" text="Course Name" prefWidth="250" />
                    <TableColumn fx:id="gradeValueColumn" text="Grade" prefWidth="80" />
                    <TableColumn fx:id="gradeNumericColumn" text="Numeric" prefWidth="80" />
                    <TableColumn fx:id="gradeDateColumn" text="Date" prefWidth="150" />
                </columns>
            </TableView>

            <HBox spacing="10">
                <Label text="Total Credits:" style="-fx-font-weight: bold;" />
                <Label fx:id="totalCreditsLabel" text="0" />
                <Label text="GPA:" style="-fx-font-weight: bold; -fx-padding: 0 0 0 20;" />
                <Label fx:id="gpaLabel" text="0.00" />
            </HBox>
        </VBox>
    </center>

    <!-- Bottom: Actions -->
    <bottom>
        <HBox spacing="10" style="-fx-padding: 15;" alignment="CENTER">
            <Button text="Refresh" onAction="#refreshGrades" prefWidth="120" />
            <Button text="Back to Dashboard" onAction="#handleBack" prefWidth="150" />
        </HBox>
    </bottom>
</BorderPane>
