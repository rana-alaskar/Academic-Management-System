<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="academicmanagmentsystem.controller.CourseRegistrationController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Course Registration" style="-fx-font-size: 18; -fx-font-weight: bold;" />

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Search:" />
        <TextField fx:id="searchField" promptText="Search by course code or name" prefWidth="300" />
        <Button text="Search" onAction="#handleSearch" />
        <Button text="Refresh" onAction="#refreshCourses" />
    </HBox>

    <Label text="Available Courses" style="-fx-font-weight: bold;" />

    <TableView fx:id="coursesTable" prefHeight="350">
        <columns>
            <TableColumn fx:id="courseCodeColumn" text="Course Code" prefWidth="120" />
            <TableColumn fx:id="courseNameColumn" text="Course Name" prefWidth="250" />
            <TableColumn fx:id="creditHoursColumn" text="Credits" prefWidth="80" />
            <TableColumn fx:id="instructorColumn" text="Instructor" prefWidth="150" />
            <TableColumn fx:id="semesterColumn" text="Semester" prefWidth="100" />
            <TableColumn fx:id="enrolledColumn" text="Enrolled" prefWidth="80" />
            <TableColumn fx:id="capacityColumn" text="Capacity" prefWidth="80" />
        </columns>
    </TableView>

    <Label fx:id="messageLabel" textFill="GREEN" style="-fx-font-weight: bold;" />

    <HBox spacing="10" alignment="CENTER">
        <Button text="Enroll in Selected Course" onAction="#handleEnroll" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="200" />
        <Button text="Back to Dashboard" onAction="#handleBack" prefWidth="150" />
    </HBox>
</VBox>
